# ---------------------------------------------------------------------------
# Client (Vite) — exposed to the browser. Safe to be public (anon key + RLS).
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# ---------------------------------------------------------------------------
# Server (WhatsApp agent, /api/whatsapp) — set these in Vercel Project Settings,
# NOT prefixed with VITE_ so they never reach the browser bundle. Never commit
# real values.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # secret; bypasses RLS
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6                    # optional override
TWILIO_AUTH_TOKEN=your-twilio-auth-token             # used to verify webhook signatures
WHATSAPP_ALLOWED_FROM=whatsapp:+27821234567          # the only sender allowed to use the bot
OWNER_USER_ID=00000000-0000-0000-0000-000000000000   # Supabase auth user id the agent reads/writes

# Local testing only — bypasses Twilio signature checks. NEVER set in production.
# SKIP_TWILIO_VALIDATION=true
